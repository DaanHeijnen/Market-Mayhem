# Required for Admin login
ADMIN_USERNAME=admin
ADMIN_PASSWORD=12345

# Required. Use at least 32 random characters. Changing it invalidates sessions.
SESSION_SECRET=replace-with-at-least-32-random-characters

# Netlify Database supplies this in hosted environments. For a manually managed
# local PostgreSQL setup you can provide a compatible connection URL here.
# NETLIFY_DATABASE_URL=postgresql://user:password@localhost:5432/market_mayhem
